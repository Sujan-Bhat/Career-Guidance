# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
# Comma-separated hostnames; REQUIRED when DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- MongoDB ----
# Inside docker-compose use hostnames `mongo`; for local dev use localhost
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=careermind

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Django cache backend for login throttling; omit to fall back to LocMem
REDIS_URL=redis://localhost:6379/2

# ---- CORS ----
FRONTEND_URL=http://localhost:3000

# ---- Part A: External LLM API ----
# provider: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# Gemini only: comma-separated fallbacks tried in order when the primary hits
# its per-model daily quota (429) or is retired (404); each has its own bucket
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
